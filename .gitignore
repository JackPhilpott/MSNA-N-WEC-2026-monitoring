# RStudio / R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# renv (commit renv.lock itself, not the library)
renv/library/
renv/staging/
renv/python/

# Raw KoBo pulls and any local data exchange - sensitive/reproducible, not
# for version control (mirrors 1_sampling/'s input_data/ convention)
input_data/
data/

# This repo tracks the dashboard app only. cleaning/ (raw KoBo exports,
# per-partner progress spreadsheets - real submission data) and
# field_verify/ (inter-partner boundary-dispute correspondence) are kept
# out of version control entirely - never pushed anywhere from here.
cleaning/
field_verify/

# Generated hand-off reports (e.g. generate_fact_digest.R) - regenerated
# on demand, sent directly to the recipient, not tracked in git
reports/

# Shiny deployment metadata (machine/account-specific)
dashboard_app/rsconnect/

# Assist tool local settings (machine/user-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS
Thumbs.db
Desktop.ini
